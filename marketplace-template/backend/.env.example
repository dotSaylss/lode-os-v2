# ── Marketplace template — backend configuration ─────────────────────────────
# Copy this file to `.env` and edit. NEVER commit `.env`.
#
# The backend runs out-of-the-box with NO configuration at all: it uses the
# deterministic "mock" matchmaker so you can demo the full UX with zero keys.
# Everything below is optional and only needed to enable the real Gemini agent
# or to re-brand the marketplace.

# ── Matchmaker backend ───────────────────────────────────────────────────────
# auto (default): real Gemini agent when credentials are present, else mock.
# real: force the Gemini agent (fails loudly if creds/deps are missing).
# mock: force the dependency-free deterministic matcher.
# MATCHMAKER_MODE=auto

# ── Gemini credentials (only needed for the real matchmaker) ─────────────────
# Option A — Vertex AI via Application Default Credentials.
# Run `gcloud auth application-default login`, then set:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
#
# Option B — Google AI Studio API key (simplest, no GCP project needed):
# GOOGLE_API_KEY=your-ai-studio-api-key

# ── Branding (optional — re-theme without touching code) ─────────────────────
# MARKETPLACE_NAME=Sound Collective
# MARKETPLACE_TAGLINE=Vetted collaborators matched to your song's needs.
# MATCHMAKER_NAME=Matchmaker

# ── Data source (optional) ───────────────────────────────────────────────────
# Point at a different providers JSON file. Defaults to backend/data/providers.json.
# PROVIDERS_DB=/absolute/path/to/providers.json

# ── Deployment (optional) ────────────────────────────────────────────────────
# Comma-separated extra CORS origins (your deployed frontend URL).
# FRONTEND_ORIGINS=https://your-frontend.example.com
